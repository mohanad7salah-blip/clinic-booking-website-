{
  "name": "alz-dental-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Booking API for Dr. Ali Al-Zubaidi Dental Clinic (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute alz_booking --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute alz_booking --remote --file=./schema.sql",
    "admin:create": "node scripts/create-admin.mjs",
    "test": "node --test tests/",
    "test:concurrency": "node scripts/concurrency-test.mjs",
    "test:idempotency": "node scripts/idempotency-test.mjs",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  },
  "engines": { "node": ">=20" }
}
